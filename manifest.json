{
  "manifest_version": 3,
  "name": "DevPulse – Modern Developer Dashboard",
  "version": "2.0.0",
  "description": "Minimalist developer dashboard replacing your New Tab page with GitHub activity and Tech News.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://hacker-news.firebaseio.com/*"
  ],
  "icons": {
    "16": "icons/icons16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}