{
  "manifest_version": 3,
  "name": "DevPulse – Noir Developer Dashboard",
  "version": "3.0.0",
  "description": "A noir-styled developer new tab: case files, stakeout timer, GitHub intel, tech news, status board and a pocket toolbox.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://hacker-news.firebaseio.com/*",
    "https://www.githubstatus.com/*",
    "https://www.vercel-status.com/*",
    "https://www.cloudflarestatus.com/*",
    "https://discordstatus.com/*"
  ],
  "icons": {
    "16": "icons/icons16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}